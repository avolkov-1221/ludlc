menu "LuDLC"

config LUDLC
	bool "LuDLC stack"
	default n
	help
	  Enable the LuDLC.

if LUDLC

config LUDLC_MT
	bool
	default y

config LUDLC_WINDOW
	int "Transmit window size"
	range 1 256
	default 4
	help
	  Largest sliding-window size a connection may use. Must be a power
	  of two. With LUDLC_MULTI_CONN a link may run a smaller window via
	  its ludlc_conn_cfg.

config LUDLC_CONFIRM_BATCH
	int "Confirmations reported per lock acquisition"
	range 1 256
	default 4
	depends on LUDLC_MT
	help
	  How many confirmations are carried out of the connection lock at a
	  time, on the stack of the thread reporting them. This bounds the
	  stack rather than the work: a larger value takes the lock fewer
	  times when a whole window is confirmed at once, and costs
	  LUDLC_CONFIRM_BATCH * sizeof(struct packet_queue_item) of stack
	  while draining.

	  Set it to LUDLC_WINDOW for a single pass, which is what a small
	  window wants. Leave it lower for a window of tens or hundreds,
	  where a batch that size is more stack than a confirmation is worth.

config LUDLC_MULTI_CONN
	bool "Per-connection protocol settings"
	default n
	help
	  When disabled, every link runs LUDLC_CONN_CFG_DEFAULT (the CONFIG_*
	  values for window, payload size, ping period and default TTL).

	  When enabled, each link carries a ludlc_conn_cfg in the platform
	  args: window (up to LUDLC_WINDOW), max_payload, ping_time and
	  default_ttl may differ per connection.

config LUDLC_ID_BITS
	int "Packet ID width (bits)"
	range 8 32
	default 8
	help
	  Bit-width of packet IDs. Supported values: 8, 16, 32.

config LUDLC_PING_TIME
	int "Ping period in microseconds"
	range 1 2147483647
	default 1000000
	help
	  Keepalive ping period used by the protocol timers.

config LUDLC_PAYLOAD_BITS
	int "Payload-size type width (bits)"
	range 8 32
	default 8
	help
	  Bit-width of payload length fields. Supported values: 8, 16, 32.

config LUDLC_FRAME_BITS
	int "Frame-size type width (bits)"
	range 8 64
	default 16
	help
	  Bit-width of frame length fields. A frame is the link's payload plus
	  a header and a checksum; this type must be able to name that size
	  after any stuffing a framing adds (for example COBS on SPI). COBS's
	  255-octet stuffing group is not the frame size. Supported values:
	  8, 16, 32, 64.

config LUDLC_MAX_PAYLOAD_SIZE
	int "Maximum payload size (bytes)"
	range 1 255 if LUDLC_PAYLOAD_BITS = 8
	range 1 65535 if LUDLC_PAYLOAD_BITS = 16
	range 1 4294967295 if LUDLC_PAYLOAD_BITS = 32
	default 32
	help
	  Maximum packet payload size (unsigned).
	  The effective upper limit follows LUDLC_PAYLOAD_BITS:
	  255 for 8-bit payload length, 65535 for 16-bit, and
	  4294967295 for 32-bit.

config LUDLC_CHANNEL_BITS
	int "Channel ID width (bits)"
	range 8 32
	default 8
	help
	  Bit-width of channel identifiers. Supported values: 8, 16, 32.

config LUDLC_CONTROL_CHANNEL
	int "Reserved control channel"
	default 0
	help
	  Reserved channel used for handshake/control packets.

config LUDLC_DEFAULT_TTL
	int "Default transmit retry budget (TTL)"
	range 1 126
	default 4
	help
	  Default retry count for queued packets.

config LUDLC_CSUM_BITS
	int "Checksum type width (bits)"
	range 8 64
	default 16
	help
	  Bit-width of checksum type. Supported values: 8, 16, 32, 64.

config LUDLC_TIMESTAMP_BITS
	int "Timestamp type width (bits)"
	range 8 64
	default 64
	help
	  Bit-width of timestamp type. Supported values: 8, 16, 32, 64.

config LUDLC_STATS
	bool "Enable LuDLC runtime statistics"
	default y
	help
	  This option stores runtime protocol counters in each connection
	  state, including transmit activity, receive activity, and error
	  events. The counters are useful for diagnostics, validation, and
	  field troubleshooting because they expose protocol behavior over
	  time. Disable this option only when minimizing memory footprint is
	  more important than runtime observability.

config LUDLC_FRAMING_HDLC
	bool "HDLC framing"
	default y
	help
	  Delimit a frame with LUDLC_SOF, and escape that octet and LUDLC_ESC
	  where they occur inside the frame. A frame grows by one octet per
	  occurrence, so the worst case is twice its length.

config LUDLC_FRAMING_COBS
	bool "COBS framing"
	default y
	help
	  Delimit a frame with LUDLC_COBS_DELIMITER and remove that octet from
	  inside the frame, so a frame grows by one octet per 254 rather than
	  by its content. Costs more code than the escaping and about the same
	  RAM.

config LUDLC_FRAMING_RAW
	bool "Raw framing"
	default y
	help
	  Send the octets unchanged, with no delimiter. Usable only where the
	  transport delimits frames itself, which here means SPI, where the
	  length is announced before each frame.

config LUDLC_STATIC_FRAMING_NUM
	int "Framing objects preallocated per framing"
	default 1 if !LUDLC_MULTI_CONN
	default 0
	help
	  How many links can open at once before the framing calls k_calloc().
	  Every framing preallocates this many objects, so set it to the number
	  of links that may run the same framing. The default of one covers a
	  build with one framing and one link. At zero, every link takes its
	  framing from the heap, which then has to be enabled.

config LUDLC_SERIAL_CONN
	bool "LuDLC Serial connection support"
	default n
	depends on SERIAL
	# For the CRC-16/KERMIT of the default args, and for an application
	# that brings its own checksum.
	select CRC
	select EVENTS
	help
	  Build LuDLC with serial (UART) connection support. A link delimits
	  its frames with the HDLC escaping unless the application asks for
	  COBS instead.

config LUDLC_STATIC_SERIAL_CONN
	bool "Predefine LuDLC Serial connection as static array"
	default n
	depends on LUDLC_SERIAL_CONN

config LUDLC_STATIC_SERIAL_CONN_NUM
	int "Number of predefine connections"
	default 1
	depends on LUDLC_STATIC_SERIAL_CONN

config LUDLC_NUM_RX_BUFFERS
	int "Number of RX packet buffers"
	range 1 64
	default 3
	depends on LUDLC_SERIAL_CONN
	help
	  Number of RX packet buffers used by Zephyr serial transport.

menu "Sample options"

rsource "../src/samples/zephyr/ludlc_echo/Kconfig.sample"

endmenu

endif # LUDLC

endmenu
