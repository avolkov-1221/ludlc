if LUDLC

menu "Echo sample"

config LUDLC_ECHO_PERIODIC_TX
	bool "Enable periodic ECHO packet transmission"
	default y
	help
	  This option controls whether the echo sample generates its own
	  periodic ECHO traffic. When enabled, the sample transmits one ECHO
	  packet per second in addition to normal reply traffic triggered by
	  received packets. When disabled, the sample operates in reply-only
	  mode and sends ECHO packets only as direct responses to peer input.

config LUDLC_ECHO_SPI
	bool "Run the echo link over SPI rather than over a UART"
	default n
	depends on LUDLC_SPI_CONN
	help
	  Put the link on the SPI peripheral this board describes, with
	  the Linux ludlc_spi_master driver as the controller, instead of
	  on uart0. The board overlay says which peripheral and which
	  GPIO carries the data-ready line; without such a line the
	  controller has to poll.

	  The sample logic is the same either way: only which transport
	  the connection is created on changes.

endmenu

endif
